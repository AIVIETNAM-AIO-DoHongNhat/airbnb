# Cổng chạy backend (NestJS), API prefix /api, Swagger ở /docs
PORT=3099

# Kết nối MySQL. Định dạng: mysql://user:password@host:port/database
# Project chạy MySQL qua Docker container, mở port 3307 ở máy host
DATABASE_URL=mysql://root:your_password@localhost:3307/airbnb?allowPublicKeyRetrieval=true

# JWT secrets — ĐỔI thành chuỗi ngẫu nhiên của riêng bạn
ACCESS_TOKEN_SECRET=change_me_access_secret
ACCESS_TOKEN_EXPIRES=1h
REFRESH_TOKEN_SECRET=change_me_refresh_secret
REFRESH_TOKEN_EXPIRES=7d
